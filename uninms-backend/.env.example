# ─── Copy this file to .env and fill in your values ─────────────────────────
# cp .env.example .env

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1
FRONTEND_URL=http://localhost:3001

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uninms
DB_USER=uninms_user
DB_PASSWORD=uninms_dev_password
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=uninms_dev_password
REDIS_DB=0

# ─── JWT — CHANGE THESE ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── OpenAI (for semantic search) ────────────────────────────────────────────
# Leave blank to disable semantic search — full-text search still works
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ─── AWS S3 (for file uploads) ───────────────────────────────────────────────
# Leave blank to disable file uploads
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=uninms-documents

# ─── Africa's Talking (for USSD/SMS) ─────────────────────────────────────────
# Leave blank to disable USSD
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_MAX=100
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_SEARCH_MAX=60

# ─── File Uploads ────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50

# ─── Paystack (payment gateway) ──────────────────────────────────────────────
# Get keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_your_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_key_here

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=UniNMS <noreply@uninms.edu.ng>
APP_URL=http://localhost:3001

# ─── Plagiarism — External Services ─────────────────────────────────────────

# GPTZero (AI-generated text detection)
# Get key: https://gptzero.me/api  — free tier: 10 req/day
GPTZERO_API_KEY=

# Bing Web Search (verbatim web snippet matching)
# Get key: Azure Portal → Cognitive Services → Bing Search v7 → F1 free tier (1,000 calls/mo)
# https://portal.azure.com/#create/Microsoft.BingSearch
BING_SEARCH_KEY=

# Copyleaks (deep check: 60B+ web pages, paraphrase detection, AI detection)
# Sign up: https://copyleaks.com  → API dashboard → generate API key
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=

# Public-facing backend URL — used by Copyleaks to POST webhook results back
# Must be reachable from the internet (use ngrok in development)
BACKEND_URL=

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs
