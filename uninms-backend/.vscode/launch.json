{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "UniNMS API (debug)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/server.js",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "restart": true,
      "runtimeArgs": ["--watch"],
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    },
    {
      "name": "Run migrations",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/migrate.js",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Run seed",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed.js",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
